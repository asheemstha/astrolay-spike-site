---
import { intro, photo } from '../../data/home';
const [small, large] = intro.images;
const badge = 'Trusted since 2009 • Boutique real estate • ';
---
<section class="intro container" id="about">
  <span class="label intro__label">(01) {intro.label}</span>
  <p class="intro__text" data-scrub-text>{intro.text}</p>

  <div class="intro__gallery">
    <figure class="intro__img intro__img--small" data-speed="0.6">
      <img src={photo(small.id, 700, 900)} width="700" height="900" alt={small.alt} loading="lazy" />
    </figure>

    <div class="intro__badge" data-spin aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <defs>
          <path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
        </defs>
        <!-- textLength stretches the text to exactly one lap of the circle (2π × 78) -->
        <text textLength="488" lengthAdjust="spacing">
          <textPath href="#badge-circle" textLength="488" lengthAdjust="spacing">{badge}</textPath>
        </text>
      </svg>
      <span class="intro__badge-star">✺</span>
    </div>

    <figure class="intro__img intro__img--large" data-speed="-0.4">
      <img src={photo(large.id, 1400, 1000)} width="1400" height="1000" alt={large.alt} loading="lazy" />
    </figure>

    <div class="intro__cta" data-fade-up>
      <p>From first viewing to the final signature, one team stays with you — no hand-offs, no pressure, no surprises.</p>
      <a href="#advisors" class="btn" data-magnetic>Meet the team</a>
    </div>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-6);
    padding-block: var(--section-gap);
  }

  .intro__label {
    grid-column: 1 / span 3;
    padding-top: 0.9em;
  }

  .intro__text {
    grid-column: 4 / -1;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1rem + 3.2vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-indent: 12%;

    /* SplitText wraps each word in an inline-block, which would inherit the indent */
    & :global(*) {
      text-indent: 0;
    }
  }

  .intro__gallery {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-6);
    margin-top: var(--section-gap);
    align-items: start;
  }

  .intro__img {
    overflow: hidden;
    border-radius: var(--radius);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .intro__img--small {
    grid-column: 1 / span 4;
    grid-row: 1;
    aspect-ratio: 7 / 9;
    margin-top: 30%;
  }

  .intro__img--large {
    grid-column: 6 / -1;
    grid-row: 1;
    aspect-ratio: 7 / 5;
  }

  .intro__badge {
    grid-column: 4 / span 3;
    grid-row: 1;
    z-index: 1;
    position: relative;
    align-self: end;
    width: clamp(8rem, 13vw, 12rem);
    aspect-ratio: 1;
    margin-bottom: -3rem;
    color: var(--color-text);

    & svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    & text {
      font-family: var(--font-mono);
      font-size: 13.5px;
      text-transform: uppercase;
      fill: currentColor;
    }
  }

  .intro__badge-star {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 2rem;
    color: var(--color-primary);
  }

  .intro__cta {
    grid-column: 6 / span 5;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-6);
    margin-top: var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  @media (max-width: 899px) {
    .intro__label,
    .intro__text,
    .intro__img--small,
    .intro__img--large,
    .intro__cta {
      grid-column: 1 / -1;
    }

    .intro__text {
      margin-top: var(--space-6);
      text-indent: 0;
    }

    .intro__img--small {
      grid-row: 2;
      width: 55%;
      margin-top: calc(-1 * var(--space-16));
      justify-self: end;
    }

    .intro__badge {
      display: none;
    }
  }
</style>
