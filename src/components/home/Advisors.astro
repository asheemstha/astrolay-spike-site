---
import { advisors, photo } from '../../data/home';
---
<section class="advisors container" id="advisors">
  <div class="advisors__head">
    <span class="label">(05) Advisors</span>
    <h2 class="advisors__title" data-split-lines>People who actually <em>pick up</em> the phone</h2>
  </div>

  <ul class="advisors__grid">
    {advisors.map((a) => (
      <li class="advisor" data-advisor data-cursor-label="Say hi">
        <div class="advisor__media" data-advisor-media>
          <img src={photo(a.image, 700, 875)} width="700" height="875" alt={`Portrait of ${a.name}`} loading="lazy" data-advisor-img />
        </div>
        <h3 class="advisor__name">{a.name}</h3>
        <p class="label advisor__role">{a.role}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .advisors {
    padding-block: var(--section-gap);
  }

  .advisors__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-16);

    & .label {
      grid-column: 1 / span 3;
      padding-top: 1em;
    }
  }

  .advisors__title {
    grid-column: 4 / -1;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6.5rem);

    & em {
      color: var(--color-primary);
    }
  }

  .advisors__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  /* Staggered columns for an editorial rhythm */
  .advisor:nth-child(even) {
    margin-top: var(--space-16);
  }

  .advisor__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1);
      transition: filter 0.8s var(--ease-out), scale 1.2s var(--ease-out);
    }
  }

  .advisor:hover .advisor__media img {
    filter: grayscale(0);
    scale: 1.05;
  }

  .advisor__name {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
  }

  .advisor__role {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  @media (max-width: 899px) {
    .advisors__head {
      & .label,
      & .advisors__title {
        grid-column: 1 / -1;
      }
    }

    .advisors__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-4);
    }
  }
</style>
